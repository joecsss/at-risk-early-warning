# ตัวอย่างไฟล์ความลับของแอป (Streamlit secrets)
#
# วิธีใช้: คัดลอกไฟล์นี้เป็น .streamlit/secrets.toml แล้วเปลี่ยนรหัสผ่านให้เป็นของตัวเอง
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# ไฟล์ secrets.toml ถูกกันไว้ใน .gitignore แล้ว — ห้าม commit ขึ้น GitHub
# ถ้าไม่มีไฟล์ secrets.toml แอปยังทำงานได้ แต่จะเข้ามุมมอง "ผู้ดูแลระบบ" ไม่ได้
# (บนเว็บ Streamlit Community Cloud ให้ตั้งค่านี้ใน Settings → Secrets)

ADMIN_PASSWORD = "เปลี่ยนรหัสนี้"

# ฐานข้อมูลออนไลน์ (ไม่บังคับ) — ถ้าไม่ใส่ แอปใช้ SQLite ในเครื่อง data/kku_app.db
# Supabase: Project → Connect → Session pooler → URI (แทน [YOUR-PASSWORD] ด้วยรหัสฐานข้อมูล)
# DATABASE_URL = "postgresql://postgres.xxxxxxxx:รหัสผ่าน@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
